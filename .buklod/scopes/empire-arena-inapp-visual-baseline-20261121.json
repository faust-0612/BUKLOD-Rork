  "scopeManifestPath": ".buklod/scopes/empire-arena-inapp-visual-baseline-20261121.json",
  "objective": "Embed Arena V2 offline practice into the existing BUKLOD Main app, reuse canonical combat and art, and version generated artwork into the native visual baseline without owner-side downloading. Add isolated server-authoritative real-time ranked backend without enabling client-owned match decisions or touching production.",
  "baseRef": "dev/empire-arena-v2-connected-world-preview-20261121",
  "productionBaselineEvidence": "Only GitHub source and the existing DEV Arena V2 simulation inspected. No production APK, OTA or server artifact claimed verified.",
