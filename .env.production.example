# Production values belong in EAS production environment variables.
# This file is only a naming/template reference.
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PRODUCTION-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
EAS_PROJECT_ID=REPLACE_WITH_EAS_PROJECT_UUID

# AdMob production identifiers are stored in EAS production environment variables.
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_COMMUNITY_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_COMMUNITY_ENTRY_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_PROFILE_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_ORG_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_CLUSTER_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_ORG_COMMUNITY_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_CLUSTER_COMMUNITY_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_CONTENT_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_CONTENT_SUBMISSION_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_VIDEO_COMPANION_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=

# Native Android IMA engine is included in the APK.
# Set true only with a verified production Google Ad Manager VAST/VMAP tag.
EXPO_PUBLIC_IMA_VIDEO_ENABLED=false
EXPO_PUBLIC_IMA_AD_TAG_URL=
EXPO_PUBLIC_IMA_USE_GOOGLE_SAMPLE_TAG=false

EXPO_PUBLIC_ADMOB_COMMUNITY_NATIVE_UNIT_ID=
EXPO_PUBLIC_ADMOB_ORG_COMMUNITY_NATIVE_UNIT_ID=
EXPO_PUBLIC_ADMOB_CLUSTER_COMMUNITY_NATIVE_UNIT_ID=
