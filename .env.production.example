# BUKLOD Report — production environment naming reference.
# Real values belong in the EAS production environment / secure build workspace.
# Never commit real credentials.

EXPO_PUBLIC_APP_ENV=production
BUKLOD_APP_TARGET=report

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PRODUCTION-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional web-only AdSense banner for the top-level Report dashboard.
# Keep disabled until the real publisher client + ad unit slot are provisioned.
EXPO_PUBLIC_REPORT_ADSENSE_ENABLED=false
EXPO_PUBLIC_REPORT_ADSENSE_CLIENT=ca-pub-REPLACE_ME
EXPO_PUBLIC_REPORT_ADSENSE_SLOT=REPLACE_WITH_NUMERIC_AD_UNIT_SLOT

# Dedicated standalone BUKLOD Report Expo/EAS project UUID.
REPORT_EAS_PROJECT_ID=REPLACE_WITH_REPORT_EAS_PROJECT_UUID
# Optional alias supported by app.config.js / preflight:
EXPO_PUBLIC_REPORT_EAS_PROJECT_ID=

# Android only. Must point to the dedicated Firebase config whose package is
# org.mzbministry.buklod.report. Never point this at BUKLOD Main credentials.
REPORT_GOOGLE_SERVICES_FILE=REPLACE_WITH_SECURE_BUILD_FILE_PATH

# Set per release command/preflight invocation.
REPORT_RELEASE_TARGET=web
