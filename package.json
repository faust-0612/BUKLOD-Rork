    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "16.3.4",
    "react-native-maps": "1.27.2",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-pager-view": "8.0.2",
