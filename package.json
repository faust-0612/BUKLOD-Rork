    "react-native-svg": "15.15.4",
    "react-native-tab-view": "^4.3.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/qrcode": "^1.5.6",
