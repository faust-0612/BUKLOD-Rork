{
  "name": "buklod",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:db": "supabase test db",
    "doctor": "npx expo-doctor@latest",
    "character:contract": "node scripts/character-release-contract.mjs && node scripts/character-active-renderer-gate.mjs",
    "character:contract:dist": "node scripts/character-release-contract.mjs --dist dist && node scripts/character-active-renderer-gate.mjs",
    "game:contract": "node scripts/game-kingdom-release-contract.mjs && node scripts/test-kingdom-game-platform-r1.mjs && node --experimental-strip-types --test tests/kingdom-games-r2.test.mjs tests/kingdom-games-r3.test.mjs tests/kingdom-games-r4.test.mjs tests/kingdom-games-r5.test.mjs tests/kingdom-premium-map-r6.test.mjs tests/kingdom-games-r7.test.mjs tests/kingdom-games-r8.test.mjs",
    "game:contract:dist": "node scripts/game-kingdom-release-contract.mjs --dist dist",
    "release:base-gate": "node scripts/release-gate.mjs",
    "release:gate": "npm run character:contract && npm run game:contract && npm run release:base-gate",
    "quality": "npm run test && npm run test:db && npm run release:gate",
    "staging:gate": "node scripts/staging-gate.mjs",
    "supabase:local:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "build:android:preview": "eas build --platform android --profile preview",
    "dev:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/BUILD_DEV_APK.ps1",
    "ota:main": "powershell -ExecutionPolicy Bypass -File ./scripts/PUSH_MAIN_OTA.ps1",
    "production:preflight": "node scripts/production-preflight.mjs",
    "production:migrations": "node scripts/verify-production-migrations.mjs",
    "production:dry-run": "bash scripts/production-cutover.sh",
    "production:android": "bash scripts/build-android-production.sh",
    "play:draft": "bash scripts/submit-google-play-draft.sh",
    "play:internal": "bash scripts/submit-google-play-internal.sh"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/app/"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "@expo/ui": "~57.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
