# BUKLOD Report — standalone environment template
# Never commit real production values or secrets.

EXPO_PUBLIC_APP_ENV=development
BUKLOD_APP_TARGET=report

# Shared/canonical backend client configuration
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional standalone Report web banner advertising.
# Banner remains hidden unless ENABLED is true and both values are valid.
# Never hard-code these values in source components.
EXPO_PUBLIC_REPORT_ADSENSE_ENABLED=false
EXPO_PUBLIC_REPORT_ADSENSE_CLIENT=
EXPO_PUBLIC_REPORT_ADSENSE_SLOT=

# Dedicated Expo/EAS identity for BUKLOD Report only.
# Do NOT reuse BUKLOD Main EAS_PROJECT_ID.
REPORT_EAS_PROJECT_ID=
# Optional public alias accepted by the standalone Report config/preflight.
EXPO_PUBLIC_REPORT_EAS_PROJECT_ID=

# Android only: path to the dedicated Firebase google-services.json for
# org.mzbministry.buklod.report (or the staging package for staging builds).
# Keep the real file outside source control and provision it in the build environment.
REPORT_GOOGLE_SERVICES_FILE=

# Explicit release target used by standalone production preflight.
# Allowed values: web | android
REPORT_RELEASE_TARGET=web
