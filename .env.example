EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EAS_PROJECT_ID=
# Android Maps key belongs in EAS production (sensitive). Never commit a real key.
GOOGLE_MAPS_ANDROID_API_KEY=

# Standalone BUKLOD Report launcher
# Canonical/default door target is the original production address:
# https://buklod-report-mzb.expo.app
# QA/staging may explicitly override this with a stable QA URL. Never put
# authentication/session tokens in this URL.
EXPO_PUBLIC_BUKLOD_REPORT_WEB_URL=

# Connect GIF library (GIPHY)
# GIPHY recommends a separate API key per platform/integration. The generic key
# is accepted as a development fallback when a platform-specific key is absent.
EXPO_PUBLIC_GIPHY_API_KEY=
EXPO_PUBLIC_GIPHY_ANDROID_API_KEY=
EXPO_PUBLIC_GIPHY_IOS_API_KEY=
EXPO_PUBLIC_GIPHY_WEB_API_KEY=

# AdMob
# Native Android App ID is an EAS secret (ADMOB_ANDROID_APP_ID) and is baked
# into production binaries only. Staging/development native builds use Google's
# sample App ID. JS unit IDs below are used only when EXPO_PUBLIC_APP_ENV=production.
# Staging, preview, development, and __DEV__ always request Google test ads.
# LEGACY/HISTORICAL ONLY in BUKLOD Main. Do not reuse for Community Wall.
EXPO_PUBLIC_ADMOB_HOME_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_COMMUNITY_BANNER_UNIT_ID=
# Surface-specific inventory. Leave blank to use the safe existing fallback unit.
EXPO_PUBLIC_ADMOB_COMMUNITY_ENTRY_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_PROFILE_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_ORG_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_CLUSTER_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_CONTENT_SUBMISSION_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_VIDEO_COMPANION_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_PRAYER_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_MESSAGES_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_CONTENT_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=
# Optional native units. IGPAT prefers its dedicated native unit and falls back
# to the Community native unit when the IGPAT unit is not configured.
EXPO_PUBLIC_ADMOB_COMMUNITY_NATIVE_UNIT_ID=
EXPO_PUBLIC_ADMOB_REELS_NATIVE_UNIT_ID=
# Optional rewarded unit. Production rewarded ads remain disabled when absent.
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=
# Optional comma-separated hashed test device IDs for staging/dev.
EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=

# Canonical Main pacing: content first, ads asynchronous and centrally tunable.
EXPO_PUBLIC_ADS_WALL_MIN_CONTENT_BEFORE_FIRST_AD=8
EXPO_PUBLIC_ADS_WALL_CONTENT_INTERVAL=10
EXPO_PUBLIC_ADS_WALL_INTERVAL_MIN=8
EXPO_PUBLIC_ADS_WALL_INTERVAL_MAX=12
EXPO_PUBLIC_ADS_REELS_MIN_CONTENT_BEFORE_FIRST_AD=8
EXPO_PUBLIC_ADS_REELS_CONTENT_INTERVAL=10
EXPO_PUBLIC_ADS_REELS_INTERVAL_MIN=8
EXPO_PUBLIC_ADS_REELS_INTERVAL_MAX=12
EXPO_PUBLIC_ADS_INTERSTITIAL_MIN_EVENTS=3
EXPO_PUBLIC_ADS_INTERSTITIAL_MIN_INTERVAL_MS=720000
EXPO_PUBLIC_ADS_SESSION_INTERSTITIAL_CAP=3
EXPO_PUBLIC_ADS_SLOT_REMOUNT_COOLDOWN_MS=120000
EXPO_PUBLIC_ADS_TELEMETRY_FLUSH_MS=45000
EXPO_PUBLIC_ADS_TELEMETRY_BATCH_KEYS=20

# Google IMA / Ad Manager in-stream video monetization.
# Keep disabled until a production VAST/VMAP tag is configured and device-tested.
EXPO_PUBLIC_IMA_VIDEO_ENABLED=false
EXPO_PUBLIC_IMA_AD_TAG_URL=
# Development/preview only; never enable sample tags in production.
EXPO_PUBLIC_IMA_USE_GOOGLE_SAMPLE_TAG=false
