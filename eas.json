{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "report-development",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_ENV": "development",
        "BUKLOD_APP_TARGET": "report"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "report-preview",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "BUKLOD_APP_TARGET": "report"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "report-production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "BUKLOD_APP_TARGET": "report"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {},
    "google-play-draft": {
      "android": {
        "releaseStatus": "draft"
      }
    },
    "google-play-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
