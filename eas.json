{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_STREAM_ANDROID_PUSH_PROVIDER_NAME": "firebase-video-staging"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_STREAM_ANDROID_PUSH_PROVIDER_NAME": "firebase-video-staging"
      },
      "autoIncrement": true
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_STREAM_ANDROID_PUSH_PROVIDER_NAME": "firebase-video-production",
        "EXPO_PUBLIC_APP_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "dev-apk": {
      "extends": "production-apk"
    },
    "e2e-test": {
      "withoutCredentials": true,
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    },
    "direct": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "dev-native-120": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_STREAM_ANDROID_PUSH_PROVIDER_NAME": "firebase-video-staging"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "staging-user": {
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_STREAM_ANDROID_PUSH_PROVIDER_NAME": "firebase-video-staging"
      },
      "distribution": "internal",
      "channel": "staging-user",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "staging-dev": {
      "env": {
        "EXPO_PUBLIC_STREAM_ANDROID_PUSH_PROVIDER_NAME": "firebase-video-staging",
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "developmentClient": true,
      "distribution": "internal",
      "channel": "staging-dev",
      "environment": "preview"
    },
    "classroom-preview": {
      "distribution": "internal",
      "channel": "classroom-preview",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "BUKLOD_APP_TARGET": "classroom",
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "CLASSROOM_GOOGLE_SERVICES_FILE": "./google-services.classroom.json"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "classroom-production": {
      "channel": "classroom-production",
      "environment": "production",
      "env": {
        "BUKLOD_APP_TARGET": "classroom",
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "CLASSROOM_GOOGLE_SERVICES_FILE": "./google-services.classroom.json"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "classroom-production-apk": {
      "extends": "classroom-production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "season2-genesis-preview": {
      "extends": "staging-user",
      "channel": "season2-genesis-preview",
      "distribution": "internal",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_BUKLOD_SEASON2_GENESIS_PREVIEW": "true",
        "EXPO_PUBLIC_STREAM_ANDROID_PUSH_PROVIDER_NAME": "firebase-video-staging",
        "EXPO_PUBLIC_BUKLOD_GENESIS_SHARED_BACKEND_REVIEW": "true",
        "EXPO_PUBLIC_BUKLOD_ARENA_EXPERIMENTAL": "true",
        "EXPO_PUBLIC_SUPABASE_URL": "https://yhanxndaqbmuzbdqlblu.supabase.co",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_RWvrYHzgLMvBousgwn4dTg_QawYzwRS",
        "EXPO_PUBLIC_BUKLOD_ARENA_RANKED_ENABLED": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "season2-genesis-sos-preview": {
      "extends": "season2-genesis-preview",
      "channel": "season2-genesis-preview",
      "environment": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_BUKLOD_SEASON2_GENESIS_PREVIEW": "true",
        "EXPO_PUBLIC_STREAM_ANDROID_PUSH_PROVIDER_NAME": "firebase-video-staging",
        "EXPO_PUBLIC_BUKLOD_GENESIS_SHARED_BACKEND_REVIEW": "true",
        "EXPO_PUBLIC_BUKLOD_ARENA_EXPERIMENTAL": "true",
        "EXPO_PUBLIC_SUPABASE_URL": "https://yhanxndaqbmuzbdqlblu.supabase.co",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_RWvrYHzgLMvBousgwn4dTg_QawYzwRS",
        "EXPO_PUBLIC_BUKLOD_ARENA_RANKED_ENABLED": "false",
        "EXPO_PUBLIC_BUKLOD_SOS_NATIVE_R3": "true"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {},
    "google-play-draft": {
      "android": {
        "releaseStatus": "draft"
      }
    },
    "google-play-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
