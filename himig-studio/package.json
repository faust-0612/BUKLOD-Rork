{
  "name": "himig-studio-expo-web",
  "version": "0.2.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --web",
    "build:web": "npm run build:worker && expo export --platform web",
    "build:worker": "esbuild src/songWorker.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=public/audio-worker.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build:web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.14",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "lamejs": "^1.2.1",
    "lucide-react": "^0.469.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.0",
    "typescript": "~5.9.2",
    "esbuild": "^0.28.2"
  }
}
